---
interface Props {
  h1: string;
  intro?: string;
  stats?: Array<{ num: string; label: string }>;
}

const { h1, intro, stats = [] } = Astro.props;

const VIDEO_ID = '-4yX8WRkiOA';
const THUMB = `https://i.ytimg.com/vi/${VIDEO_ID}/maxresdefault.jpg`;
const CTA_HREF = 'https://wa.me/553171421239?text=Ol%C3%A1!%20Gostaria%20de%20saber%20mais%20sobre%20o%20Krav%20Mag%C3%A1%20no%20Studio%20Livel.';
---

<section class="km-hero" aria-labelledby="km-h1">
  <div class="km-hero__noise" aria-hidden="true"></div>

  <div class="wrap km-hero__inner">

    <!-- Lado esquerdo: texto -->
    <div class="km-hero__content">
      <p class="km-hero__over">
        Krav Magá · Studio Livel
      </p>

      <h1 id="km-h1" class="km-hero__h1">{h1}</h1>

      {intro && <p class="km-hero__intro">{intro}</p>}

      <div class="km-hero__btns">
        <button
          type="button"
          class="btn btn--red btn--lg"
          onclick="window.kmOpenPopup && window.kmOpenPopup()"
        >
          Agendar aula gratuita
        </button>
        <a href="#como-funciona" class="btn btn--outline-white btn--lg">
          Como funciona
        </a>
      </div>

      {stats.length > 0 && (
        <dl class="km-hero__stats">
          {stats.map(s => (
            <div class="km-hero__stat">
              <dt class="km-hero__stat-num">{s.num}</dt>
              <dd class="km-hero__stat-label">{s.label}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>

    <!-- Lado direito: vídeo -->
    <div class="km-hero__video-wrap">
      <div class="km-hero__video" id="km-yt-wrap">
        <button
          class="km-yt-thumb"
          id="km-yt-btn"
          aria-label="Reproduzir vídeo: Krav Maga no Studio Livel"
          style={`background-image:url('${THUMB}')`}
        >
          <span class="km-yt-play" aria-hidden="true">
            <svg width="72" height="72" viewBox="0 0 72 72" fill="none">
              <circle cx="36" cy="36" r="36" fill="rgba(0,0,0,.5)" />
              <circle cx="36" cy="36" r="35" stroke="rgba(255,255,255,.25)" stroke-width="1" />
              <polygon points="29,22 55,36 29,50" fill="#fff" />
            </svg>
          </span>
          <span class="km-yt-label">Ver o treino na prática</span>
        </button>
      </div>
    </div>

  </div>
</section>

<script is:inline define:vars={{ VIDEO_ID }}>
(function() {
  var btn = document.getElementById('km-yt-btn');
  if (!btn) return;
  btn.addEventListener('click', function() {
    var wrap = document.getElementById('km-yt-wrap');
    if (!wrap) return;
    var iframe = document.createElement('iframe');
    iframe.src = 'https://www.youtube.com/embed/' + VIDEO_ID + '?autoplay=1&start=42&rel=0';
    iframe.title = 'Krav Maga no Studio Livel';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:none;border-radius:14px;';
    wrap.innerHTML = '';
    wrap.appendChild(iframe);
  }, { once: true });
}());
</script>

<style>
.km-hero {
  position: relative;
  background: linear-gradient(135deg, #1a0303 0%, #2d0808 40%, #1a0505 70%, #0d0d0d 100%);
  padding: 72px 0 80px;
  overflow: hidden;
  min-height: 560px;
  display: flex;
  align-items: center;
}

/* Textura de grain */
.km-hero__noise {
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(ellipse 70% 80% at 75% 50%, rgba(192,24,26,.12) 0%, transparent 65%),
    url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.04'/%3E%3C/svg%3E");
  pointer-events: none;
}

.km-hero__inner {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 48px;
  align-items: center;
  z-index: 1;
}

/* Over */
.km-hero__over {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #f08080;
  margin-bottom: 18px;
}

.km-hero__over-line {
  display: inline-block;
  width: 28px;
  height: 2px;
  background: #f08080;
  flex-shrink: 0;
}

/* H1 */
.km-hero__h1 {
  font-family: 'Instrument Serif', Georgia, serif;
  font-size: clamp(2rem, 4.5vw, 3.2rem);
  color: #fff;
  line-height: 1.12;
  margin-bottom: 20px;
}

.km-hero__intro {
  font-size: 1rem;
  color: rgba(255,255,255,.6);
  line-height: 1.65;
  margin-bottom: 32px;
  max-width: 440px;
}

/* Botões */
.km-hero__btns {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 36px;
}

.km-hero__btns .btn {
  flex: 1 1 auto;
  text-align: center;
  justify-content: center;
}

.btn--outline-white {
  background: transparent;
  border: 1.5px solid rgba(255,255,255,.4);
  color: #fff;
  transition: border-color .2s, background .2s;
}
.btn--outline-white:hover {
  border-color: rgba(255,255,255,.75);
  background: rgba(255,255,255,.06);
}

/* Stats */
.km-hero__stats {
  display: flex;
  gap: 28px;
  flex-wrap: nowrap;
  border-top: 1px solid rgba(192,24,26,.35);
  padding-top: 24px;
}

.km-hero__stat { display: flex; flex-direction: column; gap: 2px; }

.km-hero__stat-num {
  font-family: 'Instrument Serif', Georgia, serif;
  font-size: 1.7rem;
  color: #fff;
  line-height: 1;
}

.km-hero__stat-label {
  font-size: .75rem;
  color: rgba(255,255,255,.45);
  text-transform: uppercase;
  letter-spacing: .06em;
}

/* Vídeo */
.km-hero__video-wrap {
  width: 100%;
}

.km-hero__video {
  position: relative;
  aspect-ratio: 16 / 9;
  border-radius: 14px;
  overflow: hidden;
  background: #0a0a0a;
  box-shadow: 0 24px 64px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.06);
}

.km-yt-thumb {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  border: none;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 0;
  transition: filter .25s;
}

.km-yt-thumb::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.3);
  transition: background .25s;
}

.km-yt-thumb:hover::after { background: rgba(0,0,0,.15); }

.km-yt-play {
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 4px 20px rgba(0,0,0,.6));
  transition: transform .25s;
}

.km-yt-thumb:hover .km-yt-play { transform: scale(1.1); }

.km-yt-label {
  position: relative;
  z-index: 1;
  font-size: .82rem;
  font-weight: 700;
  color: rgba(255,255,255,.9);
  letter-spacing: .06em;
  text-transform: uppercase;
  text-shadow: 0 2px 8px rgba(0,0,0,.8);
}

/* Responsivo */
@media (max-width: 900px) {
  .km-hero__inner {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .km-hero {
    padding: 56px 0 64px;
    min-height: unset;
  }

  .km-hero__intro { max-width: 100%; }
}
</style>
