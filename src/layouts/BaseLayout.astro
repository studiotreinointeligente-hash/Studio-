---
import SchemaLD from '../components/SchemaLD.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PreFooterCTA from '../components/PreFooterCTA.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  schema?: Record<string, unknown>;
  andar?: 'roxo' | 'gold' | 'orange' | 'gray' | 'red' | 'none';
  activePath?: string;
  lcpImage?: string;
  ogImage?: string;
  isYMYL?: boolean;
  noindex?: boolean;
  hideCta?: boolean;
}

const {
  title,
  description,
  canonical,
  schema,
  andar = 'none',
  activePath = '',
  lcpImage,
  ogImage = '/images/logos/logo-livel-og.jpg',
  isYMYL = false,
  noindex = false,
  hideCta = false,
} = Astro.props;

const siteUrl = 'https://www.studiotreinointeligente.com.br';
const fullOg  = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="google-site-verification" content="68A9aAwyF_RRWI87kfPZw8-LkQ_J_Btc5QaFy_oLgNw" />
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-WQZ14JK43G"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-WQZ14JK43G');

    document.addEventListener('click', function (e) {
      var link = e.target.closest && e.target.closest('a[href*="wa.me"], a[href*="api.whatsapp.com"]');
      if (link) {
        gtag('event', 'whatsapp_click', {
          link_url: link.href,
          page_path: location.pathname
        });
      }
    });
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <meta name="color-scheme" content="light" />

  <!-- Preload LCP image (com type para o browser saber se aceita o formato) -->
  {lcpImage && (
    <link
      rel="preload"
      as="image"
      href={lcpImage}
      type={lcpImage.endsWith('.avif') ? 'image/avif' : lcpImage.endsWith('.webp') ? 'image/webp' : undefined}
      fetchpriority="high"
    />
  )}

  <!-- Preload fontes críticas para destravar o LCP (Univers LT aparece nos H1/H2) -->
  <link rel="preload" href="/fonts/Univers_LT_75_Black.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
  <link rel="preload" href="/fonts/Univers_LT_55_Roman.ttf" as="font" type="font/ttf" crossorigin="anonymous" />

  <!-- Favicons -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Referrer Policy via meta (funciona em todos os browsers) -->
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <!-- X-Frame-Options e X-Content-Type-Options são aplicados via HTTP headers (_headers / vercel.json) -->

  <!-- SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  {!noindex && isYMYL && <meta name="robots" content="index, follow, max-image-preview:large" />}

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonical} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={fullOg} />
  <meta property="og:locale"      content="pt_BR" />
  <meta property="og:site_name"   content="Studio Livel Treino Inteligente" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={fullOg} />

  <!-- Preconnect desnecessário: fontes são self-hosted -->
  <!-- DNS para WhatsApp (CTA) -->
  <link rel="dns-prefetch" href="//wa.me" />

  <!-- Schema JSON-LD -->
  {schema && <SchemaLD schema={schema} />}

  <!-- Fontes críticas self-hosted: @font-face inline com URLs absolutas (Univers LT — H1/H2) -->
  <style is:global>
    @font-face {
      font-family: 'Univers LT';
      font-style: normal; font-weight: 800; font-display: swap;
      src: url('/fonts/Univers_LT_75_Black.ttf') format('truetype');
    }
    @font-face {
      font-family: 'Univers LT';
      font-style: normal; font-weight: 400; font-display: swap;
      src: url('/fonts/Univers_LT_55_Roman.ttf') format('truetype');
    }
  </style>

  <!-- CSS crítico inline + global -->
  <style is:global>
    @import '/src/styles/global.css';
  </style>
</head>

<body>
  <a href="#main-content" class="skip-link">Pular para o conteúdo principal</a>
  <Nav andar={andar} activePath={activePath} />
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  {!hideCta && <PreFooterCTA />}
  <Footer />
  <WhatsAppWidget />
</body>
</html>

<style is:global>
.skip-link {
  position: absolute; top: -100px; left: 20px;
  background: var(--roxo); color: #fff; padding: 8px 16px;
  border-radius: 0 0 var(--r-md) var(--r-md); font-weight: 600; font-size: 14px;
  text-decoration: none; z-index: 9999; transition: top 0.2s;
}
.skip-link:focus { top: 0; }
</style>
